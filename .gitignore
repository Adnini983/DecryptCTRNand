# build intermediates (the compiled jar is NOT committed; build via java\build.bat)
java/classes/
*.jar

# test run output, and the generated vectors (reproducible: python tests\make_testvectors.py)
# tests\expected\ IS committed: it is the pinned oracle used for regression checks.
tests/out/
tests/vectors/
tests/vec_log.txt

# temp files (unique per-run names are <out>.<guid>.tmp / <out>.bak.<guid>)
*.tmp
*.bak
*.bak.*

# AI-agent onboarding doc (local only, not committed)
AGENTS.md
